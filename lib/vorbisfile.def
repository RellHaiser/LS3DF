; Import definitions for vorbisfile.dll (the names LS3DF.dll imports; build.py makes the .lib with
; MinGW dlltool: "Sym@N == _Sym@N" keeps the decorated __stdcall export name).
LIBRARY vorbisfile.dll
EXPORTS
    ov_clear
    ov_info
    ov_open_callbacks
    ov_read
    ov_time_seek
    ov_time_tell
